# This file is used to store environment variables for your application. You can define variables here and access them in your code using process.env.VARIABLE_NAME.
# Copy to `.env` and fill in real values. Every key below is validated by src/lib/env.ts
# unless noted otherwise.

# App URLs
# APP_URL is the server-side base for SSR tRPC requests. Use plain http locally --
# `next dev` runs without TLS, so an https:// origin fails every server-rendered call.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=xxx
CLERK_SECRET_KEY=xxx

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Postgres (local Docker via docker.compose.yml)
DATABASE_URL=xxx

# Cloudflare R2 (audio storage)
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_NAME=xxx
R2_TOKEN=xxx

# Chatterbox TTS API
CHATTERBOX_API_URL=https://example.modal.run
CHATTERBOX_API_KEY=xxx

# Hugging Face (voice model downloads)
HF_ACCESS_TOKEN=xxx

# Set to skip env validation entirely (e.g. Docker builds)
SKIP_ENV_VALIDATION=true
